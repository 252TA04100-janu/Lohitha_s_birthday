*{
margin:0;
padding:0;
box-sizing:border-box;
scroll-behavior:smooth;
}

body{
font-family:'Poppins',sans-serif;
background:#ffffff;
overflow-x:hidden;
color:#444;
}

/* Loader */

#loader{
position:fixed;
width:100%;
height:100%;
background:white;
display:flex;
justify-content:center;
align-items:center;
z-index:9999;
font-size:35px;
font-family:'Great Vibes',cursive;
animation:fadeLoader 3s forwards;
}

@keyframes fadeLoader{

0%{opacity:1;}

90%{opacity:1;}

100%{
opacity:0;
visibility:hidden;
}

}

/* Hero */

.hero{

height:100vh;

background:linear-gradient(135deg,#ffffff,#fff5f8);

display:flex;

flex-direction:column;

justify-content:center;

align-items:center;

text-align:center;

padding:20px;

position:relative;

overflow:hidden;

}

.hero h1{

font-size:65px;

font-family:'Great Vibes',cursive;

color:#d81b60;

margin-bottom:20px;

animation:zoom 2s;

}

.hero h3{

font-size:32px;

color:#ff4081;

margin-bottom:15px;

}

.subtitle{

font-size:24px;

color:#777;

margin-bottom:30px;

}

button{

padding:16px 40px;

border:none;

border-radius:40px;

background:#ff4081;

color:white;

font-size:18px;

cursor:pointer;

transition:.4s;

box-shadow:0 10px 25px rgba(255,64,129,.3);

}

button:hover{

transform:scale(1.08);

background:#e91e63;

}

@keyframes zoom{

from{

transform:scale(.5);

opacity:0;

}

to{

transform:scale(1);

opacity:1;

}

}

/* Countdown */

#countdown{

padding:80px 20px;

background:#fff;

text-align:center;

}

#countdown h2{

font-size:45px;

color:#e91e63;

margin-bottom:40px;

}

.timer{

display:flex;

justify-content:center;

flex-wrap:wrap;

gap:25px;

}

.timer div{

width:130px;

padding:25px;

background:#fff5f8;

border-radius:20px;

box-shadow:0 10px 20px rgba(0,0,0,.1);

}

.timer span{

font-size:45px;

font-weight:bold;

color:#ff4081;

}

.timer p{

margin-top:10px;

font-size:18px;

}
/* Message Section */

#message{

padding:80px 20px;

background:#fffafc;

text-align:center;

}

#message h2{

font-size:45px;

color:#e91e63;

margin-bottom:30px;

}

#message p{

max-width:900px;

margin:auto;

font-size:22px;

line-height:2;

color:#555;

}

/* Gallery */

#gallery{

padding:80px 20px;

background:white;

text-align:center;

}

#gallery h2{

font-size:45px;

margin-bottom:40px;

color:#e91e63;

}

.gallery{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(250px,1fr));

gap:25px;

max-width:1200px;

margin:auto;

}

.gallery img{

width:50%;

height:320px;

object-fit:cover;

border-radius:20px;

box-shadow:0 10px 25px rgba(0,0,0,.15);

transition:.5s;

}

.gallery img:hover{

transform:scale(1.05);

}

/* Cake */

#cake{

padding:80px 20px;

background:#fff5f8;

text-align:center;

}

.cake{

font-size:120px;

animation:bounce 2s infinite;

}

@keyframes bounce{

0%,100%{

transform:translateY(0);

}

50%{

transform:translateY(-20px);

}

}

/* Balloons */

.balloons{

position:fixed;

width:100%;

top:100%;

left:0;

display:flex;

justify-content:space-around;

pointer-events:none;

font-size:40px;

animation:floatBalloon 15s linear infinite;

}

@keyframes floatBalloon{

0%{

transform:translateY(0);

}

100%{

transform:translateY(-140vh);

}

}

/* Butterflies */

.butterflies{

position:fixed;

top:20%;

left:-10%;

font-size:35px;

animation:fly 18s linear infinite;

pointer-events:none;

}

@keyframes fly{

0%{

transform:translateX(0);

}

100%{

transform:translateX(120vw);

}

}

/* Roses */

.roses{

position:fixed;

top:0;

width:100%;

text-align:center;

font-size:28px;

animation:roseFall 8s linear infinite;

pointer-events:none;

}

@keyframes roseFall{

0%{

transform:translateY(-60px);

}

100%{

transform:translateY(110vh);

}

  }

/* Final Section */

#final{
padding:100px 20px;
background:linear-gradient(135deg,#fff,#ffeef5);
text-align:center;
}

#final h1{
font-size:60px;
font-family:'Great Vibes',cursive;
color:#e91e63;
margin-bottom:20px;
}

#final h2{
font-size:35px;
margin-bottom:20px;
color:#ff4081;
}

#final p{
max-width:850px;
margin:auto;
font-size:22px;
line-height:2;
color:#555;
}

/* Footer */

footer{
padding:30px;
background:#ff4081;
color:white;
text-align:center;
font-size:18px;
}

/* Floating Hearts */

body::before{
content:"❤️ ❤️ 🌹 🦋 ❤️ 🌹";
position:fixed;
left:0;
top:-50px;
width:100%;
font-size:28px;
animation:hearts 15s linear infinite;
pointer-events:none;
opacity:.6;
}

@keyframes hearts{

0%{
transform:translateY(-60px);
}

100%{
transform:translateY(120vh);
}

}

/* Mobile Responsive */

@media(max-width:768px){

.hero h1{
font-size:42px;
}

.hero h3{
font-size:24px;
}

.timer{
flex-direction:column;
align-items:center;
}

.timer div{
width:220px;
}

.gallery{
grid-template-columns:1fr;
}

.gallery img{
height:auto;
}

#message p,
#final p{
font-size:18px;
line-height:1.8;
}

#countdown h2,
#gallery h2,
#message h2,
#music h2{
font-size:32px;
}

#final h1{
font-size:42px;
}

}
